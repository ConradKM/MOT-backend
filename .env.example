FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://mot:mot@localhost:5432/mot_garage
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Public booking (POST /api/public/<slug>/booking-requests) ---
# Server-verified CAPTCHA. The token from the booking wizard is POSTed to the
# provider's verify endpoint with CAPTCHA_SECRET before the request is created;
# a failure returns 400 and creates nothing. Cloudflare Turnstile is the
# recommended provider (recaptcha / hcaptcha also supported).
#
# Local dev uses Cloudflare's published TEST keys so the real verification path
# runs without a Cloudflare account (secret below always passes; the frontend
# pairs it with test site key 1x00000000000000000000AA). PRODUCTION MUST set a
# real secret and MUST NOT use "none".
#   always-pass secret: 1x0000000000000000000000000000000AA
#   always-fail secret: 2x0000000000000000000000000000000AA
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=1x0000000000000000000000000000000AA
# "none" disables verification entirely - only for tests / offline work.
# Optional: override the provider's verify URL.
# CAPTCHA_VERIFY_URL=

# Rate limit for the public booking endpoint (Flask-Limiter syntax).
PUBLIC_BOOKING_RATELIMIT=5 per hour;20 per day
# Looser limit for the read-only availability calendar the wizard polls.
PUBLIC_AVAILABILITY_RATELIMIT=60 per minute
# Where Flask-Limiter keeps its counters; defaults to REDIS_URL, then in-memory.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/3

# --- Checklist evidence storage (app/storage) ---
# "none" (default) = no real storage, stand-in presigned URLs (local dev).
# "s3" = any S3-compatible bucket. Production is designed around Cloudflare R2;
# MinIO works for local testing (STORAGE_ENDPOINT_URL=http://localhost:9000).
STORAGE_BACKEND=none
STORAGE_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com  ·  MinIO: http://localhost:9000
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGN_EXPIRY=900
MEDIA_MAX_BYTES=104857600
