# So `flask <cmd>` works without the `--app app:create_app` flag every time.
FLASK_APP=app:create_app
# Deployment environment. "development" (the default) unlocks the local-only
# helpers `flask seed-dev` and `flask dev-info`, which print seeded logins and
# internal ids. Set to "production" on any real deployment to disable them.
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://mot:mot@localhost:5432/mot_garage
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Web server (gunicorn.conf.py; production Docker CMD) ---
# The image runs `gunicorn --config gunicorn.conf.py wsgi:app` with a gevent
# worker (serves REST + the app/ws/* WebSocket routes). All optional:
# PORT is injected by the host (Render); the rest have sane defaults.
# WEB_CONCURRENCY=2
# GUNICORN_WORKER_CONNECTIONS=1000
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# --- CORS (app/__init__.py) ---
# Browser origins allowed to call /api/* cross-origin, comma-separated. The
# local dev frontend proxies /api same-origin and needs no entry; this is for
# deployed static builds that hit the API directly. Never "*" (the API is
# bearer-authenticated). Unset = the built-in default below (localhost dev +
# preview, plus the production app). Set this to override.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://app.comaz.co.uk,https://comaz.co.uk

# --- Public booking (POST /api/public/<slug>/booking-requests) ---
# Server-verified CAPTCHA. The token from the booking wizard is POSTed to the
# provider's verify endpoint with CAPTCHA_SECRET before the request is created;
# a failure returns 400 and creates nothing. Cloudflare Turnstile is the
# recommended provider (recaptcha / hcaptcha also supported).
#
# Local dev uses Cloudflare's published TEST keys so the real verification path
# runs without a Cloudflare account (secret below always passes; the frontend
# pairs it with test site key 1x00000000000000000000AA). PRODUCTION MUST set a
# real secret and MUST NOT use "none".
#   always-pass secret: 1x0000000000000000000000000000000AA
#   always-fail secret: 2x0000000000000000000000000000000AA
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=1x0000000000000000000000000000000AA
# "none" disables verification entirely - only for tests / offline work.
# Optional: override the provider's verify URL.
# CAPTCHA_VERIFY_URL=

# --- Garage auth & password reset --------------------------------------
# Where reset links point (the frontend origin). Must not be a hardcoded
# production domain here.
APP_BASE_URL=http://localhost:5173
# Outbound email. "console" logs the message (incl. the reset link) for local
# dev; set a real provider (resend / postmark / sendgrid / ses) + EMAIL_API_KEY
# in production - the console backend never runs there.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@localhost
# EMAIL_API_KEY=
PASSWORD_RESET_TOKEN_MINUTES=30
AUTH_LOGIN_RATELIMIT=10 per minute;100 per hour
AUTH_RESET_RATELIMIT=5 per hour;20 per day

# --- Garage onboarding (app/garages/onboarding.py) --------------------
# Tenants are created with `flask onboard-garage` (see docs/GARAGE_ONBOARDING.md).
# POST /api/auth/register calls the same service; set "false" to make
# onboarding CLI-only (the HTTP endpoint then 404s).
ONBOARDING_HTTP_ENABLED=true

# Rate limit for the public booking endpoint (Flask-Limiter syntax).
PUBLIC_BOOKING_RATELIMIT=5 per hour;20 per day
# Looser limit for the read-only availability calendar the wizard polls.
PUBLIC_AVAILABILITY_RATELIMIT=60 per minute
# Where Flask-Limiter keeps its counters; defaults to REDIS_URL, then in-memory.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/3

# --- Checklist evidence storage (app/storage) ---
# "none" (default) = no real storage, stand-in presigned URLs (local dev).
# "s3" = any S3-compatible bucket. Production is designed around Cloudflare R2;
# MinIO works for local testing (STORAGE_ENDPOINT_URL=http://localhost:9000).
STORAGE_BACKEND=none
STORAGE_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com  ·  MinIO: http://localhost:9000
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGN_EXPIRY=900
MEDIA_MAX_BYTES=104857600

# --- Twilio communications (app/communications) ------------------------
# CoMaz OS's own (master) Twilio account. Leave both unset for local dev -
# the app starts and the booking flow works normally; is_twilio_configured()
# is False, outbound sends are recorded as SKIPPED_NOT_CONFIGURED instead of
# calling Twilio, and the webhook endpoints below respond 503. Never commit
# real values here.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Recommended for production: a Twilio Standard API Key (SID starts "SK") and
# its secret. When BOTH are set, the outbound REST client authenticates with
# the API key + Account SID instead of the Auth Token (a key can be rotated or
# revoked independently). The Auth Token is still required - it's what verifies
# inbound webhook signatures. Leave unset to authenticate REST calls with the
# Auth Token, as dev/test and any un-keyed deployment do.
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# Twilio signs every webhook request; this is verified before anything is
# trusted (app/communications/security.py). Only set "false" for local/manual
# testing with a client that can't produce a real Twilio signature -
# production must leave this true (the default).
TWILIO_WEBHOOK_VALIDATE=true
# Off by default: whether an inbound WhatsApp message gets an immediate
# generic acknowledgement reply. No conversational bot - see
# app/communications/whatsapp_webhooks.py.
TWILIO_WHATSAPP_AUTO_ACK=false
# This deployment's own public HTTPS origin (no trailing slash). Used only to
# print the exact webhook URLs to give Twilio (`flask twilio-webhook-urls`)
# and to build the URL that incoming webhook signatures are checked against -
# never point this at localhost; use a tunnel (e.g. ngrok) for local testing
# against a real Twilio number, and the real deployment domain in production.
PUBLIC_API_BASE_URL=http://localhost:5001

# Webhook endpoints Twilio will eventually call (see docs/TWILIO_SETUP.md for
# the full external setup checklist):
#   POST {PUBLIC_API_BASE_URL}/api/webhooks/twilio/voice/incoming
#   POST {PUBLIC_API_BASE_URL}/api/webhooks/twilio/voice/status
#   POST {PUBLIC_API_BASE_URL}/api/webhooks/twilio/whatsapp/incoming
#   POST {PUBLIC_API_BASE_URL}/api/webhooks/twilio/whatsapp/status

# --- ConversationRelay voice assistant (app/communications/voice_relay.py) ---
# Off by default: inbound calls get the static <Say> greeting. Set "true" to
# have a resolved inbound call return <Connect><ConversationRelay> pointing at
# the WebSocket bridge (wss://{PUBLIC_API_BASE_URL}/api/ws/twilio/voice, so
# PUBLIC_API_BASE_URL must be a real HTTPS origin). Needs Twilio configured and
# the gunicorn gevent worker (the production Docker CMD).
TWILIO_CONVERSATIONRELAY_ENABLED=false
# en-GB by default - never US English for a UK business. Leave provider/voice
# unset for the provider's default voice for the language.
CONVERSATIONRELAY_LANGUAGE=en-GB
# CONVERSATIONRELAY_TTS_PROVIDER=      # Google | Amazon | ElevenLabs
# CONVERSATIONRELAY_VOICE=             # provider-specific voice id

# --- Conversation engine (app/conversation) --------------------------
# Consecutive not-understood turns (and "which service?" clarification
# rounds inside a booking) before the engine hands off to a human.
# Deliberately forgiving - an odd transcription or an unknown acronym is
# clarified, not escalated. Default 3.
# CONVERSATION_MAX_UNRESOLVED_TURNS=3
